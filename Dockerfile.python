# Bastion Python Services — MCP Server & A2A Server
# Multi-stage build for minimal image size
#
# Build: docker build -f Dockerfile.python -t bastion-python .
# Run MCP: docker run -e BASTION_CONN=... bastion-python python -m bastion.mcp_server --transport http
# Run A2A: docker run -e BASTION_CONN=... bastion-python python -m bastion.a2a_server

FROM python:3.12-slim AS builder

WORKDIR /app

# Install system deps for psycopg
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency files first for layer caching
COPY pyproject.toml requirements.lock ./

# Install Python deps from lock file
RUN pip install --no-cache-dir -r requirements.lock 2>/dev/null || \
    pip install --no-cache-dir -e ".[all]" 2>/dev/null || \
    pip install --no-cache-dir "psycopg[binary]>=3.1,<4" \
        "httpx>=0.27,<1" "anyio>=4.0,<5" "boto3>=1.34,<2" \
        "structlog>=24.1,<25" "pydantic>=2.0,<3" "pydantic-settings>=2.0,<3" \
        "fastapi>=0.115" "uvicorn>=0.32" "mcp>=1.0" \
        "cryptography>=42.0" "google-cloud-kms>=2.20" "groq>=0.12" \
        "sentence-transformers>=3.0,<4"

# Install ccloud CLI for agent operations
RUN curl -L https://binaries.cockroachdb.com/ccloud/ccloud_linux-amd64_0.6.12.tar.gz \
    | tar -xz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/ccloud

# Copy application code
COPY src/ /app/src/
COPY .agents/skills/ /app/.agents/skills/
