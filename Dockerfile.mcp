# Bastion MCP Server — Production Dockerfile
# Optimized for Render, AWS ECS, or any container platform
#
# Build:  docker build -f Dockerfile.mcp -t bastion-mcp .
# Run:    docker run -p 9997:9997 -e BASTION_CONN="postgresql://..." bastion-mcp
# Health: curl http://localhost:9997/healthz

FROM python:3.12-slim AS builder

WORKDIR /app

# System deps for psycopg binary + ccloud download
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency files first for layer caching
COPY pyproject.toml requirements.lock ./

# Install dependencies
RUN pip install --no-cache-dir -r requirements.lock 2>/dev/null || \
    pip install --no-cache-dir -e ".[all]" 2>/dev/null || \
    pip install --no-cache-dir \
        "psycopg[binary]>=3.1,<4" \
        "httpx>=0.27,<1" \
        "anyio>=4.0,<5" \
        "boto3>=1.34,<2" \
        "structlog>=24.1,<25" \
        "pydantic>=2.0,<3" \
        "pydantic-settings>=2.0,<3" \
        "fastapi>=0.115" \
        "uvicorn>=0.32" \
        "mcp>=1.0" \
        "cryptography>=42.0" \
        "google-cloud-kms>=2.20" \
        "groq>=0.12" \
        "sentence-transformers>=3.0,<4"

# Install ccloud CLI for agent operations
RUN curl -L https://binaries.cockroachdb.com/ccloud/ccloud_linux-amd64_0.6.12.tar.gz \
    | tar -xz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/ccloud

# Runtime stage — minimal image
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy installed packages
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY src/ /app/src/

# Set Python path
ENV PYTHONPATH=/app/src

# Security: non-root user
RUN groupadd -r bastion && useradd -r -g bastion -m bastion
USER bastion

# Health check — hits /healthz every 30s
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9997/healthz')" || exit 1

# Expose MCP server port
EXPOSE 9997

# Default: MCP server over Streamable HTTP
# Override with: docker run bastion-mcp python -m bastion.mcp_server --transport stdio
CMD python -m bastion.mcp_server --transport http --host 0.0.0.0 --port ${PORT:-9997}
