{
  "mcpServers": {
    "bastion-memory": {
      "command": "python",
      "args": ["-m", "bastion.mcp_server"],
      "env": {
        "BASTION_CONN": "${BASTION_CONN}",
        "BASTION_API_KEY": "${BASTION_API_KEY}",
        "GROQ_API_KEY": "${GROQ_API_KEY}",
        "COCKROACHDB_MCP_API_KEY": "${COCKROACHDB_MCP_API_KEY}",
        "COCKROACHDB_CLUSTER_ID": "${COCKROACHDB_CLUSTER_ID}"
      }
    }
  }
}