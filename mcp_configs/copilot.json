{
  "servers": {
    "bastion-memory": {
      "type": "http",
      "url": "http://127.0.0.1:9997/mcp",
      "headers": {
        "Authorization": "Bearer ${BASTION_API_KEY}"
      }
    },
    "cockroachdb-cloud": {
      "type": "http",
      "url": "https://cockroachlabs.cloud/mcp",
      "headers": {
        "mcp-cluster-id": "${COCKROACHDB_CLUSTER_ID}"
      }
    }
  }
}