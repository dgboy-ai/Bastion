{
  "mcpServers": {
    "cockroachdb-cloud": {
      "autoApprove": [
        "create_database",
        "create_table",
        "explain_query",
        "get_cluster",
        "get_table_schema",
        "insert_rows",
        "list_clusters",
        "list_databases",
        "list_tables",
        "select_query",
        "show_running_queries",
        "show_statement"
      ],
      "disabled": false,
      "timeout": 60,
      "type": "streamableHttp",
      "url": "https://cockroachlabs.cloud/mcp",
      "headers": {
        "mcp-cluster-id": "${COCKROACHDB_CLUSTER_ID}"
      }
    }
  }
}