# Bastion Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.
#
# SECURITY: If you previously had real credentials in .env.local,
# rotate them immediately. Use a secrets manager in production.

# CockroachDB connection string
# Format: postgresql://user:password@host:port/database?sslmode=verify-full
BASTION_CONN=postgresql://user:password@localhost:26257/defaultdb?sslmode=disable

# Set to true to use in-memory mock backend (no DB required)
# BASTION_MOCK=true

# AWS credentials (required for Bedrock embeddings in production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# API key for MCP server authentication (REQUIRED in production)
# Without this, all API requests are rejected.
BASTION_API_KEY=change-me-to-a-random-secret

# HMAC secret for hash chain integrity (minimum 16 bytes)
# Auto-generated on first run if not set. Set explicitly in production.
# BASTION_HMAC_SECRET=change-me-to-a-random-secret-at-least-16-bytes

# A2A signing key (Ed25519, base64-encoded 32 bytes or PEM)
# Auto-generated if not set. Set explicitly for persistent agent identity.
# BASTION_A2A_PRIVATE_KEY=

# A2A trust anchors (comma-separated SHA-256 fingerprints of trusted public keys)
# In strict mode, only these keys are accepted for agent card verification.
# BASTION_A2A_TRUSTED_KEYS=

# OAuth settings for MCP server (optional)
# BASTION_MCP_OAUTH_CLIENT_ID=
# BASTION_MCP_OAUTH_CLIENT_SECRET=
# BASTION_MCP_OAUTH_REDIRECT_URI=http://localhost:3000/callback

# CORS origins (comma-separated). If empty, all cross-origin requests are blocked.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM guard (optional, requires GROQ_API_KEY)
# BASTION_LLM_GUARD=true
# GROQ_API_KEY=

# Logging
# LOG_JSON=1
# BASTION_LOG_LEVEL=INFO
