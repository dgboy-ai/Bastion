# ─────────────────────────────────────────────────────────────
# Bastion Memory — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── CockroachDB Connection ────────────────────────────────────
# Get this from: https://cockroachlabs.cloud → bastion-memory → Connect
BASTION_CONN=postgresql://divyansh:<PASSWORD>@<HOST>:26257/defaultdb?sslmode=verify-full

# ── AWS Credentials (for Bedrock Titan Embedding V2) ─────────
# Create an IAM user with bedrock:InvokeModel permissions
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1

# ── Local Development Mode ────────────────────────────────────
# Set to true to bypass all network calls (no CRDB, no Bedrock needed)
# Uses deterministic hash-based embeddings locally
BASTION_MOCK=false

# ── Optional: OpenTelemetry Endpoint ─────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Optional: Groq LLM Key (for demo chat / conflict resolution) ──
# Get from: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  # default; also: qwen/qwen3.6-27b, openai/gpt-oss-120b
