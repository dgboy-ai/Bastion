# Bastion SDK Configuration
# Copy this file to .env and fill in your values

# CockroachDB connection string (required for live mode)
BASTION_CONN=postgresql://user:password@host:26257/bastion?sslmode=require

# Set to "true" to use in-memory mock instead of live DB
BASTION_MOCK=false

# AWS Bedrock embedding model
BASTION_BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_REGION=ap-south-1

# Pool configuration
BASTION_POOL_MIN_SIZE=2
BASTION_POOL_MAX_SIZE=10

# API key for dashboard write protections
BASTION_API_KEY=

# Groq LLM guard API key (for OWASP ASI06 content validation)
GROQ_API_KEY=

# S3 bucket for Lambda CDC memory archives
BASTION_S3_BUCKET=bastion-memory-archives

# SNS topic ARN for memory chain break alerts
BASTION_ALERT_TOPIC=

# AWS KMS key ARN for zero-knowledge encryption
BASTION_AWS_KMS_KEY_ARN=

# Enable LLM-based content guard (true/false)
BASTION_LLM_GUARD=true

# A2A Ed25519 private key (base64-encoded, or leave empty for ephemeral)
BASTION_A2A_PRIVATE_KEY=

# A2A strict mode — verify all incoming agent cards
BASTION_A2A_STRICT=false

# A2A server port and host
A2A_PORT=9999
A2A_HOST=0.0.0.0

# CORS allowed origins (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000

# JSON-structured logging (true/false)
LOG_JSON=false
