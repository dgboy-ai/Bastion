# Bastion MCP Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# REQUIRED: CockroachDB Connection
# =============================================================================
# CockroachDB connection string (Serverless or Dedicated)
# Format: postgresql://user:pass@host:port/db?sslmode=verify-full
BASTION_CONN=postgresql://user:pass@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# =============================================================================
# REQUIRED: Bastion API Key (for MCP server authentication)
# =============================================================================
# Generate a secure random string: openssl rand -hex 32
BASTION_API_KEY=your-secure-api-key-here

# =============================================================================
# OPTIONAL: Groq API Key (for LLM features - dreaming, knowledge graph, etc.)
# =============================================================================
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# =============================================================================
# OPTIONAL: CockroachDB Cloud Managed MCP
# =============================================================================
# For Basic (Serverless) plan: Use OAuth browser flow (no API key needed)
# For Advanced (Dedicated) plan: Create service account in Cloud Console
#   → Assign Cluster Admin/Operator role
#   → Copy secret key
COCKROACHDB_MCP_API_KEY=your-mcp-api-key-here

# Your CockroachDB Cloud cluster ID (from Cloud Console)
COCKROACHDB_CLUSTER_ID=your-cluster-uuid-here

# =============================================================================
# OPTIONAL: AWS Configuration (for KMS, S3 features)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
BASTION_AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/...

# =============================================================================
# OPTIONAL: HMAC Secret (for hash chain integrity)
# =============================================================================
# Auto-generated if not set. Set explicitly for production deployments.
# Minimum 16 bytes, recommend 32 bytes (64 hex chars)
BASTION_HMAC_SECRET=your-hmac-secret-here

# =============================================================================
# OPTIONAL: Dashboard Configuration
# =============================================================================
# Set to "true" to enable mock mode (no database required)
BASTION_MOCK=false

# CockroachDB connection for dashboard
BASTION_DB_URL=postgresql://user:pass@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# Session secret for dashboard auth (generate: openssl rand -hex 32)
BASTION_SESSION_SECRET=your-session-secret-here

# CORS origin for dashboard (default: http://localhost:3000)
BASTION_CORS_ORIGIN=http://localhost:3000

# =============================================================================
# OPTIONAL: Guard & Logging
# =============================================================================
# Enable LLM-based guard for enhanced prompt injection detection (default: false)
BASTION_LLM_GUARD=false

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
BASTION_LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL: HuggingFace (for local embeddings)
# =============================================================================
# Required only if using local MiniLM embeddings instead of API-based embeddings
HF_TOKEN=your-huggingface-token-here

# =============================================================================
# OPTIONAL: Redis (for distributed session memory)
# =============================================================================
BASTION_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# OPTIONAL: S3 Archive Configuration
# =============================================================================
BASTION_S3_BUCKET=your-bucket-name
BASTION_S3_REGION=us-east-1