# Bastion Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# CockroachDB connection string
# Format: postgresql://user:password@host:port/database?sslmode=verify-full
BASTION_CONN=postgresql://user:password@localhost:26257/defaultdb?sslmode=disable

# Set to true to use in-memory mock backend (no DB required)
# BASTION_MOCK=true

# AWS credentials (required for Bedrock embeddings in production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# API key for A2A server authentication (recommended for production)
# BASTION_API_KEY=

# OAuth settings for MCP server (optional)
# BASTION_MCP_OAUTH_CLIENT_ID=
# BASTION_MCP_OAUTH_CLIENT_SECRET=
# BASTION_MCP_OAUTH_REDIRECT_URI=http://localhost:3000/callback

# CORS origins (comma-separated)
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM guard (optional, requires GROQ_API_KEY)
# BASTION_LLM_GUARD=true
# GROQ_API_KEY=

# Logging
# LOG_JSON=1
# BASTION_LOG_LEVEL=INFO
