{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bastion": {
      "type": "local",
      "command": ["python", "-m", "bastion.mcp_server"],
      "enabled": true,
      "environment": {
        "BASTION_CONN": "postgresql://user:pass@your-cluster.cockroachcloud.cloud:26257/bastion?sslmode=verify-full",
        "BASTION_MOCK": "false",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
